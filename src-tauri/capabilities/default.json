{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre Get a Room",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "getaroom-relay", "sidecar": true, "args": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "getaroom-relay", "sidecar": true, "args": true }]
    }
  ]
}
