{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getaroom",
  "version": "0.1.0",
  "identifier": "paris.mauve.getaroom",
  "build": {
    "beforeDevCommand": "bun run tauri:sidecar",
    "devUrl": "http://127.0.0.1:5555",
    "beforeBuildCommand": "bun run tauri:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "getaroom",
        "width": 1480,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "url": "http://127.0.0.1:5555",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:5555 ws://127.0.0.1:5555 ws://127.0.0.1:6767 wss: https:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/getaroom-relay"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "shell": {}
  }
}
