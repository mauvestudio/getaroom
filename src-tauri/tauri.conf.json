{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getaroom",
  "version": "0.1.12",
  "identifier": "paris.mauve.getaroom",
  "build": {
    "beforeDevCommand": "bun run tauri:sidecar",
    "beforeBuildCommand": "bun run tauri:bundle",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5555"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* wss: https:; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/getaroom-relay"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "shell": {}
  }
}
